  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#505050", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#99ffe4" }
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape", "constant.character.string.escape"],
      "settings": { "foreground": "#b3ffe4" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#99ffe4" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#2563eb" }
    },
    {
      "name": "Boolean / null / undefined",
      "scope": ["constant.language", "constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": { "foreground": "#2563eb" }
    },
    {
      "name": "Constant",
      "scope": ["constant", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#60a5fa" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.other"],
      "settings": { "foreground": "#a0a0a0" }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#a0a0a0" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#a0a0a0" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.section", "meta.brace"],
      "settings": { "foreground": "#a0a0a0" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
      "settings": { "foreground": "#3b82f6" }
    },
    {
      "name": "Function call",
      "scope": ["meta.function-call", "meta.method-call"],
      "settings": { "foreground": "#3b82f6" }
    },
    {
      "name": "Method",
      "scope": ["entity.name.function.method", "meta.method entity.name.function"],
      "settings": { "foreground": "#3b82f6" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "meta.type.declaration entity.name.type"],
      "settings": { "foreground": "#3b82f6" }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": { "foreground": "#93c5fd" }
    },
    {
      "name": "Enum",
      "scope": ["entity.name.type.enum"],
      "settings": { "foreground": "#93c5fd" }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace", "entity.name.module", "support.module"],
      "settings": { "foreground": "#93c5fd" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "variable.other.readwrite", "variable.parameter"],
      "settings": { "foreground": "#ffffff" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": { "foreground": "#ffffff" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#ffffff" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#2563eb" }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#60a5fa" }
    },
    {
      "name": "Macro / decorator",
      "scope": ["entity.name.function.preprocessor", "meta.preprocessor", "meta.decorator", "punctuation.decorator", "tag.decorator"],
      "settings": { "foreground": "#93c5fd" }
    },
    {
      "name": "Annotation",
      "scope": ["storage.type.annotation"],
      "settings": { "foreground": "#93c5fd" }
    },
    {
      "name": "Symbol",
      "scope": ["constant.other.symbol"],
      "settings": { "foreground": "#99ffe4" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff8080", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#505050", "fontStyle": "strikethrough" }
    },
    {
      "name": "Error",
      "scope": ["message.error"],
      "settings": { "foreground": "#ff8080" }
    },

    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "markup.heading entity.name", "entity.name.section.markdown"],
      "settings": { "foreground": "#3b82f6", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#60a5fa", "fontStyle": "underline" }
    },
    {
      "name": "Markdown link text",
      "scope": ["string.other.link.title"],
      "settings": { "foreground": "#99ffe4" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#a0a0a0", "fontStyle": "italic" }
    },
    {
      "name": "Markdown inline code",
