  "semanticTokenColors": {
    "namespace":             { "foreground": "#93c5fd" },
    "type":                  { "foreground": "#3b82f6" },
    "class":                 { "foreground": "#3b82f6" },
    "interface":             { "foreground": "#93c5fd" },
    "enum":                  { "foreground": "#93c5fd" },
    "enumMember":            { "foreground": "#60a5fa" },
    "typeParameter":         { "foreground": "#93c5fd" },
    "function":              { "foreground": "#3b82f6" },
    "method":                { "foreground": "#3b82f6" },
    "macro":                 { "foreground": "#93c5fd" },
    "variable":              { "foreground": "#ffffff" },
    "parameter":             { "foreground": "#ffffff" },
    "property":              { "foreground": "#ffffff" },
    "event":                 { "foreground": "#60a5fa" },
    "keyword":               { "foreground": "#a0a0a0" },
    "modifier":              { "foreground": "#a0a0a0" },
    "operator":              { "foreground": "#a0a0a0" },
