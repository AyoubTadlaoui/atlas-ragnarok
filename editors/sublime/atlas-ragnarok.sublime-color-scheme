{
  "name": "Atlas Ragnarok",
  "author": "Atlas Kaisar",
  "variables": {
    "bg":             "#000000",
    "bg_alt":         "#0a0a0a",
    "bg_subtle":      "#101010",
    "bg_selection":   "#1e3a5f",
    "bg_line":        "#0b1220",
    "fg":             "#ffffff",
    "fg_muted":       "#a0a0a0",
    "fg_subtle":      "#505050",
    "thunder":        "#3b82f6",
    "thunder_deep":   "#2563eb",
    "thunder_bright": "#60a5fa",
    "thunder_pale":   "#93c5fd",
    "peppermint":     "#99ffe4",
    "peppermint_alt": "#b3ffe4",
    "crimson":        "#ff8080",
    "crimson_alt":    "#ff9999",
    "gray":           "#a0a0a0"
  },
  "globals": {
    "background":              "var(bg)",
    "foreground":              "var(fg)",
    "caret":                   "var(thunder)",
    "block_caret":             "var(thunder)",
    "line_highlight":          "var(bg_line)",
    "misspelling":             "var(crimson)",
    "minimap_border":          "var(fg_subtle)",
    "accent":                  "var(thunder)",
    "popup_css":               "html, body { background-color: var(bg_alt); color: var(fg); }",

    "gutter":                  "var(bg)",
    "gutter_foreground":       "var(fg_subtle)",

    "line_diff_added":         "var(peppermint)",
    "line_diff_modified":      "var(thunder_bright)",
    "line_diff_deleted":       "var(crimson)",

    "selection":               "var(bg_selection)",
    "selection_border":        "var(thunder)",
    "inactive_selection":      "var(bg_subtle)",
    "selection_corner_style":  "round",

    "highlight":               "var(thunder_bright)",
    "find_highlight":          "var(thunder_deep)",
    "find_highlight_foreground": "var(fg)",

    "guide":                   "var(fg_subtle)",
    "active_guide":            "var(thunder)",
    "stack_guide":             "var(fg_subtle)",

    "shadow":                  "#000000",
    "tags_options":            "stippled_underline"
  },
  "rules": [
    { "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "var(fg_subtle)",
      "font_style": "italic" },

    { "name": "String",
      "scope": "string",
      "foreground": "var(peppermint)" },
    { "name": "String escape",
      "scope": "constant.character.escape",
      "foreground": "var(peppermint_alt)" },
    { "name": "Regex",
      "scope": "string.regexp",
      "foreground": "var(peppermint)" },

    { "name": "Number",
      "scope": "constant.numeric",
      "foreground": "var(thunder_deep)" },
    { "name": "Language constant (true/false/null)",
      "scope": "constant.language",
      "foreground": "var(thunder_deep)" },
    { "name": "Other constants",
      "scope": "constant.other, variable.other.constant",
      "foreground": "var(thunder_bright)" },

    { "name": "Keyword",
      "scope": "keyword",
      "foreground": "var(gray)" },
    { "name": "Operator",
      "scope": "keyword.operator, punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "var(gray)" },
    { "name": "Storage",
      "scope": "storage, storage.type, storage.modifier",
      "foreground": "var(gray)" },

    { "name": "Function",
      "scope": "entity.name.function, support.function, meta.function-call entity.name.function, variable.function",
      "foreground": "var(thunder)" },
    { "name": "Type",
      "scope": "entity.name.type, entity.name.class, support.type, support.class",
      "foreground": "var(thunder)" },
    { "name": "Interface",
      "scope": "entity.name.type.interface",
      "foreground": "var(thunder_pale)" },
    { "name": "Namespace",
      "scope": "entity.name.namespace, entity.name.module, support.module",
      "foreground": "var(thunder_pale)" },

    { "name": "Variable",
      "scope": "variable, variable.other, variable.parameter",
      "foreground": "var(fg)" },
    { "name": "Property",
      "scope": "variable.other.property, variable.other.object.property, meta.object-literal.key, support.type.property-name",
      "foreground": "var(fg)" },

    { "name": "Tag",
      "scope": "entity.name.tag, meta.tag",
      "foreground": "var(thunder_deep)" },
    { "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "var(thunder_bright)" },

    { "name": "Decorator / macro",
      "scope": "meta.decorator, punctuation.decorator, meta.preprocessor, entity.name.function.preprocessor",
      "foreground": "var(thunder_pale)" },

    { "name": "Symbol",
      "scope": "constant.other.symbol",
      "foreground": "var(peppermint)" },

    { "name": "Invalid",
      "scope": "invalid",
      "foreground": "var(crimson)",
      "font_style": "underline" },
    { "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "var(fg_subtle)" },

    { "name": "Markdown heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "var(thunder)",
      "font_style": "bold" },
    { "name": "Markdown bold",
      "scope": "markup.bold",
      "foreground": "var(fg)",
      "font_style": "bold" },
    { "name": "Markdown italic",
      "scope": "markup.italic",
      "foreground": "var(fg)",
      "font_style": "italic" },
    { "name": "Markdown link",
      "scope": "markup.underline.link, string.other.link",
      "foreground": "var(thunder_bright)",
      "font_style": "underline" },
    { "name": "Markdown inline code",
      "scope": "markup.inline.raw, markup.raw.inline",
      "foreground": "var(peppermint)" },
    { "name": "Markdown quote",
      "scope": "markup.quote",
      "foreground": "var(fg_muted)",
      "font_style": "italic" },
    { "name": "Markdown insertion",
      "scope": "markup.inserted",
      "foreground": "var(peppermint)" },
    { "name": "Markdown deletion",
      "scope": "markup.deleted",
      "foreground": "var(crimson)" },
    { "name": "Markdown change",
      "scope": "markup.changed",
      "foreground": "var(thunder_bright)" }
  ]
}
