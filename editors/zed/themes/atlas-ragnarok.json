{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Atlas Ragnarok",
  "author": "Atlas Kaisar",
  "themes": [
    {
      "name": "Atlas Ragnarok",
      "appearance": "dark",
      "style": {
        "border": "#505050",
        "border.variant": "#202020",
        "border.focused": "#3b82f6",
        "border.selected": "#3b82f6",
        "border.transparent": "#00000000",
        "border.disabled": "#202020",
        "elevated_surface.background": "#0a0a0a",
        "surface.background": "#000000",
        "background": "#000000",
        "element.background": "#0a0a0a",
        "element.hover": "#101010",
        "element.active": "#1e3a5f",
        "element.selected": "#1e3a5f",
        "element.disabled": "#0a0a0a",
        "drop_target.background": "#1e3a5f80",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#0a0a0a",
        "ghost_element.active": "#1e3a5f",
        "ghost_element.selected": "#1e3a5f",
        "ghost_element.disabled": "#0a0a0a",
        "text": "#ffffff",
        "text.muted": "#a0a0a0",
        "text.placeholder": "#505050",
        "text.disabled": "#505050",
        "text.accent": "#3b82f6",
        "icon": "#ffffff",
        "icon.muted": "#a0a0a0",
        "icon.disabled": "#505050",
        "icon.placeholder": "#505050",
        "icon.accent": "#3b82f6",

        "status_bar.background": "#000000",
        "title_bar.background": "#000000",
        "title_bar.inactive_background": "#000000",
        "toolbar.background": "#000000",
        "tab_bar.background": "#000000",
        "tab.inactive_background": "#000000",
        "tab.active_background": "#000000",
        "search.match_background": "#3b82f640",

        "panel.background": "#000000",
        "panel.focused_border": "#3b82f6",
        "pane.focused_border": "#3b82f6",
        "scrollbar.thumb.background": "#3b82f640",
        "scrollbar.thumb.hover_background": "#3b82f680",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#000000",
        "scrollbar.track.border": "#000000",

        "editor.foreground": "#ffffff",
        "editor.background": "#000000",
        "editor.gutter.background": "#000000",
        "editor.subheader.background": "#000000",
        "editor.active_line.background": "#0b1220",
        "editor.highlighted_line.background": "#0b1220",
        "editor.line_number": "#505050",
        "editor.active_line_number": "#ffffff",
        "editor.invisible": "#202020",
        "editor.wrap_guide": "#202020",
        "editor.active_wrap_guide": "#3b82f6",
        "editor.document_highlight.read_background": "#1e3a5f80",
        "editor.document_highlight.write_background": "#3b82f640",

        "terminal.background": "#000000",
        "terminal.foreground": "#ffffff",
        "terminal.bright_foreground": "#ffffff",
        "terminal.dim_foreground": "#a0a0a0",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.bright_black": "#505050",
        "terminal.ansi.dim_black": "#000000",
        "terminal.ansi.red": "#ff8080",
        "terminal.ansi.bright_red": "#ff9999",
        "terminal.ansi.dim_red": "#ff808080",
        "terminal.ansi.green": "#99ffe4",
        "terminal.ansi.bright_green": "#b3ffe4",
        "terminal.ansi.dim_green": "#99ffe480",
        "terminal.ansi.yellow": "#2563eb",
        "terminal.ansi.bright_yellow": "#60a5fa",
        "terminal.ansi.dim_yellow": "#2563eb80",
        "terminal.ansi.blue": "#a0a0a0",
        "terminal.ansi.bright_blue": "#b0b0b0",
        "terminal.ansi.dim_blue": "#a0a0a080",
        "terminal.ansi.magenta": "#3b82f6",
        "terminal.ansi.bright_magenta": "#93c5fd",
        "terminal.ansi.dim_magenta": "#3b82f680",
        "terminal.ansi.cyan": "#99ffe4",
        "terminal.ansi.bright_cyan": "#99ffe4",
        "terminal.ansi.dim_cyan": "#99ffe480",
        "terminal.ansi.white": "#ffffff",
        "terminal.ansi.bright_white": "#ffffff",
        "terminal.ansi.dim_white": "#a0a0a0",

        "link_text.hover": "#60a5fa",

        "conflict": "#ff9999",
        "conflict.background": "#380404",
        "conflict.border": "#ff9999",
        "created": "#99ffe4",
        "created.background": "#062f2f",
        "created.border": "#99ffe4",
        "deleted": "#ff8080",
        "deleted.background": "#2f0606",
        "deleted.border": "#ff8080",
        "error": "#ff8080",
        "error.background": "#380404",
        "error.border": "#ff8080",
        "hidden": "#505050",
        "hidden.background": "#000000",
        "hidden.border": "#202020",
        "hint": "#a0a0a0",
        "hint.background": "#00000000",
        "hint.border": "#3b82f6",
        "ignored": "#505050",
        "ignored.background": "#000000",
        "ignored.border": "#505050",
        "info": "#93c5fd",
        "info.background": "#0a1a2f",
        "info.border": "#93c5fd",
        "modified": "#60a5fa",
        "modified.background": "#0a1a2f",
        "modified.border": "#60a5fa",
        "predictive": "#505050",
        "predictive.background": "#00000000",
        "predictive.border": "#3b82f6",
        "renamed": "#93c5fd",
        "renamed.background": "#0a1a2f",
        "renamed.border": "#93c5fd",
        "success": "#99ffe4",
        "success.background": "#062f2f",
        "success.border": "#99ffe4",
        "unreachable": "#505050",
        "unreachable.background": "#000000",
        "unreachable.border": "#505050",
        "warning": "#2563eb",
        "warning.background": "#0a1a2f",
        "warning.border": "#2563eb",

        "players": [
          { "cursor": "#3b82f6", "background": "#3b82f6", "selection": "#1e3a5f" },
          { "cursor": "#99ffe4", "background": "#99ffe4", "selection": "#1e3a5f" },
          { "cursor": "#ff8080", "background": "#ff8080", "selection": "#380404" },
          { "cursor": "#60a5fa", "background": "#60a5fa", "selection": "#0a1a2f" },
          { "cursor": "#93c5fd", "background": "#93c5fd", "selection": "#0a1a2f" },
          { "cursor": "#b3ffe4", "background": "#b3ffe4", "selection": "#062f2f" },
          { "cursor": "#ff9999", "background": "#ff9999", "selection": "#2f0606" },
          { "cursor": "#a0a0a0", "background": "#a0a0a0", "selection": "#202020" }
        ],

        "syntax": {
          "attribute":          { "color": "#60a5fa" },
          "boolean":            { "color": "#2563eb" },
          "comment":            { "color": "#505050", "font_style": "italic" },
          "comment.doc":        { "color": "#a0a0a0", "font_style": "italic" },
          "constant":           { "color": "#60a5fa" },
          "constructor":        { "color": "#3b82f6" },
          "embedded":           { "color": "#ffffff" },
          "emphasis":           { "color": "#ffffff", "font_style": "italic" },
          "emphasis.strong":    { "color": "#ffffff", "font_weight": 700 },
          "enum":               { "color": "#93c5fd" },
          "function":           { "color": "#3b82f6" },
          "function.method":    { "color": "#3b82f6" },
          "hint":               { "color": "#a0a0a0" },
          "keyword":            { "color": "#a0a0a0" },
          "label":              { "color": "#60a5fa" },
          "link_text":          { "color": "#99ffe4" },
          "link_uri":           { "color": "#60a5fa", "font_style": "italic" },
          "number":             { "color": "#2563eb" },
          "operator":           { "color": "#a0a0a0" },
          "predictive":         { "color": "#505050", "font_style": "italic" },
          "preproc":            { "color": "#93c5fd" },
          "primary":            { "color": "#ffffff" },
          "property":           { "color": "#ffffff" },
          "punctuation":        { "color": "#a0a0a0" },
          "punctuation.bracket":{ "color": "#a0a0a0" },
          "punctuation.delimiter": { "color": "#a0a0a0" },
          "punctuation.list_marker": { "color": "#3b82f6" },
          "punctuation.special":{ "color": "#3b82f6" },
          "string":             { "color": "#99ffe4" },
          "string.escape":      { "color": "#b3ffe4" },
          "string.regex":       { "color": "#99ffe4" },
          "string.special":     { "color": "#b3ffe4" },
          "string.special.symbol": { "color": "#99ffe4" },
          "tag":                { "color": "#2563eb" },
          "text.literal":       { "color": "#99ffe4" },
          "title":              { "color": "#3b82f6", "font_weight": 700 },
          "type":               { "color": "#3b82f6" },
          "variable":           { "color": "#ffffff" },
          "variable.special":   { "color": "#93c5fd" },
          "variant":            { "color": "#60a5fa" }
        }
      }
    }
  ]
}
